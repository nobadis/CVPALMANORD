---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { Image } from "astro:assets";
import { clinic, services, specialties } from "../data/site";
import quirofano from "../assets/img/quirofano.jpg";
import consulta from "../assets/img/consulta.jpg";

const photos: Record<string, { src: ImageMetadata; alt: string }> = {
  consulta: { src: consulta, alt: "Consulta veterinaria con un perro blanco" },
  cirugia: { src: quirofano, alt: "Lámpara del quirófano de la clínica" }
};
---

<Base title="Servicios" darkHero description="Consulta general, cirugía, vacunación, identificación, desparasitación, higiene dental, hospitalización, laboratorio propio, tienda y urgencias 24h en Palma.">
  <PageHero
    eyebrow="Nuestros servicios"
    title="Todo lo que tu mascota necesita, en un solo sitio."
    lead="Manos altamente cualificadas, al día de los tratamientos más avanzados, en unas instalaciones totalmente acondicionadas y con los medios de diagnóstico más novedosos."
  >
    <nav class="jump" aria-label="Ir a un servicio" data-reveal style="--d:4">
      {services.map((s) => <a href={`#${s.id}`}><Icon name={s.icon} size={20} />{s.title}</a>)}
    </nav>
  </PageHero>

  <section class="section">
    <div class="wrap list">
      {
        services.map((s, i) => (
          <article id={s.id} class:list={["svc", { "svc-urgent": s.id === "urgencias", "svc-photo": photos[s.id] }]} data-reveal>
            <div class="svc-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
            <div class="svc-main">
              <span class="svc-icon">
                <Icon name={s.icon} size={34} />
              </span>
              <h2>{s.title}</h2>
              <p class="svc-lead">{s.lead}</p>
              <p>{s.body}</p>
              {s.id === "urgencias" && (
                <a class="btn btn-coral" href={clinic.urgent.href}>
                  <Icon name="phone" /> Llamar a urgencias · {clinic.urgent.label}
                </a>
              )}
              {s.id === "consulta" && (
                <div class="spec-wrap">
                  <h3>Especialidades</h3>
                  <ul class="specs">
                    {specialties.map((sp) => (
                      <li>
                        <Icon name="check" size={20} />
                        {sp}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            {photos[s.id] && (
              <div class="svc-img">
                <Image src={photos[s.id].src} alt={photos[s.id].alt} widths={[480, 820]} sizes="(max-width: 860px) 92vw, 40vw" />
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand title="¿No sabes qué necesita?" text="Llámanos o déjanos tus datos: te orientamos sin compromiso y te damos presupuesto." />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 40px;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.4s var(--ease);
  }
  .jump a:hover {
    background: #fff;
    color: var(--teal-900);
    transform: translateY(-2px);
  }
  .list {
    display: grid;
    gap: 20px;
  }
  .svc {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 24px;
    padding: clamp(28px, 4vw, 52px);
    border-radius: var(--radius-l);
    background: #fff;
    box-shadow: var(--shadow-s);
    scroll-margin-top: calc(var(--header-h) + 20px);
    transition: box-shadow 0.5s var(--ease);
  }
  .svc:target {
    box-shadow:
      0 0 0 3px var(--teal),
      var(--shadow);
  }
  .svc-photo {
    grid-template-columns: 90px 1.2fr 1fr;
    align-items: center;
  }
  .svc-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--teal-100);
  }
  .svc-icon {
    display: inline-grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 20px;
    background: var(--teal-50);
    color: var(--teal);
    margin-bottom: 18px;
  }
  .svc h2 {
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.8rem);
    margin-bottom: 10px;
  }
  .svc-lead {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.3rem;
    color: var(--teal);
  }
  .svc-main > p:not(.svc-lead) {
    max-width: 62ch;
    color: var(--muted);
  }
  .svc-img {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .svc-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-urgent {
    background: linear-gradient(135deg, var(--coral-ink), #8f2526);
    color: #fff;
  }
  .svc-urgent h2,
  .svc-urgent .svc-lead {
    color: #fff;
  }
  .svc-urgent .svc-main > p:not(.svc-lead) {
    color: rgba(255, 255, 255, 0.9);
  }
  .svc-urgent .svc-num {
    color: rgba(255, 255, 255, 0.3);
  }
  .svc-urgent .svc-icon {
    background: #fff;
    color: var(--coral-ink);
  }
  .svc-urgent .btn-coral {
    --bg: #fff;
    --fg: var(--coral-ink);
    margin-top: 8px;
  }
  .spec-wrap h3 {
    font-size: 1.25rem;
    margin: 12px 0 14px;
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 10px;
  }
  .specs li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--teal-50);
    font-weight: 700;
  }
  .specs .icon {
    color: var(--teal);
  }
  @media (max-width: 860px) {
    .svc,
    .svc-photo {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .svc-num {
      font-size: 2rem;
    }
    .svc-img {
      order: -1;
      margin-bottom: 12px;
    }
  }
</style>
