# Puerto HTTP (Railway lo define automaticamente)
PORT=3000

# --- Correo del formulario (Resend) ---
# Obligatoria. Sin ella el formulario no envia.
# 1) https://resend.com → Domains → Add cvpalmanord.es → copiar DNS
# 2) API Keys → Create → pegar aqui
RESEND_API_KEY=

# Ya correctos por defecto:
# MAIL_TO=cvpalmanord@cvpalmanord.es
# MAIL_FROM=cvpalmanord@cvpalmanord.es
# MAIL_FROM_NAME=Clinica Veterinaria Palmanord
# SEND_CLIENT_COPY=true

# Microsoft Clarity (opcional)
CLARITY_PROJECT_ID=
