# Puerto HTTP (Railway lo define automaticamente en produccion)
PORT=3000

# Webhook HTTPS para recibir solicitudes del formulario (Formspree, Make, n8n, etc.)
FORM_WEBHOOK_URL=https://formspree.io/f/xxxxxxxx

# Opcional: token Bearer si tu webhook lo requiere
FORM_WEBHOOK_SECRET=

# Microsoft Clarity — Project ID (el XXXX de https://www.clarity.ms/tag/XXXX).
# Sin esta variable, Clarity no se carga.
CLARITY_PROJECT_ID=
