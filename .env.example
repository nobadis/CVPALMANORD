# Puerto HTTP (Railway lo define automaticamente en produccion)
PORT=3000

# --- Correo del formulario (Dinahosting SMTPS) ---
# Host/usuario/puerto ya van por defecto en server.js.
# En Railway SOLO hace falta la contraseña de la cuenta:
SMTP_PASS=

# Opcionales (ya tienen default correcto):
# SMTP_HOST=cvpalmanord-es.correoseguro.dinaserver.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=cvpalmanord@cvpalmanord.es
# MAIL_TO=cvpalmanord@cvpalmanord.es
# MAIL_FROM=cvpalmanord@cvpalmanord.es
# MAIL_FROM_NAME=Clinica Veterinaria Palmanord
# SITE_URL=https://cvpalmanord.es
# SEND_CLIENT_COPY=true

# Microsoft Clarity — Project ID (…/tag/XXXX). Sin ella, Clarity no se carga.
CLARITY_PROJECT_ID=
